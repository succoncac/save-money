# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Turso (libSQL) Database Configuration
TURSO_DATABASE_URL="libsql://your-database.turso.io"
TURSO_AUTH_TOKEN="YOUR_TURSO_AUTH_TOKEN"

# Session Signing Secret (HMAC-SHA256 for vtk_session HttpOnly cookie)
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# AES-256-GCM Key for encrypting stored 2FA secrets & admin-recoverable credentials
DATA_ENCRYPTION_KEY="CHANGE_ME_TO_A_32_BYTE_HEX_OR_RANDOM_STRING"

# Initial Root Admin Password (seeded on first startup, forced change on first login)
ADMIN_INITIAL_PASSWORD="CHANGE_ME_INITIAL_ADMIN_PASSWORD"

# Optional Custom OpenAI-Compatible / Anthropic / OpenAI AI Configuration
CUSTOM_AI_BASE_URL="https://api.openai.com/v1"
CUSTOM_AI_API_KEY="YOUR_CUSTOM_AI_API_KEY"
CUSTOM_AI_CHAT_MODEL="claude-opus-5"
CUSTOM_AI_VISION_MODEL="auto"
